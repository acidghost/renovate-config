{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:githubActionsVersions"
  ],
  "assigneesFromCodeOwners": true,
  "labels": [
    "renovate",
    "lcm/{{updateType}}"
  ],
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": [
      "security"
    ]
  },
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "bun",
      "matchDatasources": [
        "docker",
        "github-releases",
        "npm"
      ],
      "matchDepNames": [
        "/(?:^|/)bun$/",
        "@types/bun"
      ]
    },
    {
      "groupName": "golang",
      "matchDatasources": [
        "docker",
        "github-tags",
        "golang-version"
      ],
      "matchDepNames": [
        "/^go$/",
        "/(?:^|/)golang$/"
      ]
    },
    {
      "groupName": "mise",
      "matchDatasources": [
        "docker",
        "github-release-attachments",
        "github-releases",
        "github-tags"
      ],
      "matchDepNames": [
        "/^jdx/mise-action$/",
        "/^jdx/mise$/",
        "/(?:^|/)jdxcode/mise$/"
      ]
    }
  ],
  "prHourlyLimit": 6,
  "schedule": [
    "* 0-12 * * 1"
  ]
}
