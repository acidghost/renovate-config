{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:githubActionsVersions",
    "schedule:weekly"
  ],
  "assigneesFromCodeOwners": true,
  "labels": [
    "renovate",
    "lcm/{{updateType}}"
  ],
  "minimumReleaseAge": "7 days",
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
