{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>acidghost/renovate-config",
    "local>acidghost/renovate-config:approve(minor)",
    "local>acidghost/renovate-config:approve(patch)",
    "local>acidghost/renovate-config:mise-biome"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
        "npm"
      ],
      "matchPackageNames": [
        "jdx/mise",
        "renovate"
      ],
      "schedule": [
        "* 0-4 * * 1"
      ]
    }
  ]
}
