{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Match biome version tags when installed from mise",
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "fileMatch": [
        "biome.json"
      ],
      "matchStrings": [
        "{\"currentValue\": $split($.\"$schema\",(\"/\"))[-2]}"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "biome",
      "packageNameTemplate": "@biomejs/biome"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "biome"
      ],
      "matchManagers": [
        "mise"
      ],
      "extractVersion": "@biomejs/biome@(?<version>.+)"
    }
  ]
}
